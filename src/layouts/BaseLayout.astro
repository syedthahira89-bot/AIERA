---
import katexCss from 'katex/dist/katex.min.css?url';
// Fonts are hosted on the site itself (faster, and visitors' browsers don't contact Google)
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/inter-tight/latin-400.css';
import '@fontsource/inter-tight/latin-500.css';
import '@fontsource/inter-tight/latin-600.css';
import '@fontsource/inter-tight/latin-700.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import uiFont from '@fontsource/inter-tight/files/inter-tight-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { existsSync } from 'node:fs';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Structured data for search engines (schema.org), added as JSON-LD */
  jsonLd?: Record<string, unknown>;
  /** Load the maths styles (KaTeX) only on pages that show formulas */
  math?: boolean;
}

const { title, description = SITE.description, image = '/images/og-default.jpg', imageAlt, type = 'website', publishedTime, modifiedTime, jsonLd, math = false } = Astro.props;
// Add " | AIERA-TS" only when the whole title still fits in Google results (about 60 characters)
const fullTitle = title ? (`${title} | ${SITE.name}`.length <= 60 ? `${title} | ${SITE.name}` : title) : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Use the 1200x627 sharing version of the image when the build made one (scripts/optimize-images.mjs)
const m = image.match(/^\/images\/([^/]+)\.(jpe?g|png)$/i);
const ogPath = m && existsSync(`public/images/sized/${m[1]}-og.jpg`) ? `/images/sized/${m[1]}-og.jpg` : image;
const ogImage = new URL(ogPath, Astro.site);
const ogSize = ogPath.endsWith('-og.jpg') ? [1200, 627] : image === '/images/og-default.jpg' ? [1200, 630] : null;
// Site-wide structured data on every page, plus any page-specific data
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, description: SITE.description, inLanguage: 'en',
      publisher: { '@id': `${SITE.url}/#author` } },
    { '@type': 'Person', '@id': `${SITE.url}/#author`, name: SITE.author.name, url: `${SITE.url}/about/`, description: SITE.author.bio,
      sameAs: SITE.social.map((s) => s.href) },
    ...(jsonLd ? [jsonLd] : []),
  ],
};
const ldJson = JSON.stringify(siteLd).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en" data-palette="forest">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/images/icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogSize && <meta property="og:image:width" content={String(ogSize[0])} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize[1])} />}
    <meta property="og:image:alt" content={imageAlt ?? `${SITE.name}: ${SITE.tagline}`} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.author.name} />}
    <meta name="author" content={SITE.author.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={ldJson} />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
    {SITE.analyticsSnippet && <Fragment set:html={SITE.analyticsSnippet} />}

    {math && <link rel="stylesheet" href={katexCss} />}
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      try {
        const t = localStorage.getItem('aiera-theme'); if (t) document.documentElement.dataset.theme = t;
        const p = localStorage.getItem('aiera-palette');
        if (['forest', 'peach', 'aqua', 'mint', 'lavender'].includes(p)) document.documentElement.dataset.palette = p;
      } catch (_) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
