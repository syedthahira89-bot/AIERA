---
import PostMeta from './PostMeta.astro';
import Cover from './Cover.astro';
import { formatDate } from '../data/site';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Heading level for each article title: 3 under a section heading, 2 directly under the page title */
  headingLevel?: 2 | 3;
}
const { posts, headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? 'h2' : 'h3';
---
<ul class="article-list">
  {posts.map((post, i) => (
    <li
      class="article-row"
      data-topic={post.data.topic}
      data-search={`${post.data.title} ${post.data.description} ${post.data.topic}`.toLowerCase()}
    >
      <a href={`/blog/${post.id}/`}>
        {post.data.cover && <Cover class="thumb" src={post.data.cover} width={192} height={108} sizes="(max-width: 640px) 100vw, 192px" loading={i === 0 ? 'eager' : 'lazy'} />}
        <div class="text">
          <H class="post-title">{post.data.title}</H>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <p class="dek">{post.data.description}</p>
          <PostMeta post={post} />
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .article-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .article-row { border-bottom: 1px solid var(--line); }
  .article-row:first-child { border-top: 1px solid var(--line); }
  .article-row a { display: flex; gap: 24px; align-items: flex-start; padding: 24px 4px; color: inherit; text-decoration: none; }
  .article-row a:hover .post-title { color: var(--accent-strong); }
  .article-row a:hover :global(.thumb) { transform: scale(1.02); }
  :global(.thumb) { flex: none; width: 192px; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; background: var(--raise); transition: transform .2s; }
  @media (prefers-reduced-motion: reduce) { :global(.thumb) { transition: none; } .article-row a:hover :global(.thumb) { transform: none; } }
  .text { flex: 1; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 24px; }
  .post-title { font-size: var(--step-2); transition: color .15s; }
  .dek { color: var(--muted); max-width: var(--measure); grid-column: 1; }
  .text :global(.meta) { grid-column: 1; margin-top: 4px; }
  time { grid-column: 2; grid-row: 1; font-size: var(--step--1); color: var(--muted); white-space: nowrap; padding-top: 6px; font-variant-numeric: tabular-nums; }
  @media (max-width: 720px) {
    .article-row a { flex-direction: column; gap: 14px; }
    :global(.thumb) { width: 100%; max-width: 100%; }
    .text { grid-template-columns: minmax(0, 1fr); }
    time { grid-column: 1; grid-row: auto; padding-top: 0; }
  }
</style>
