---
import { SITE, PALETTES } from '../data/site';

const links = [
  { href: '/blog/', label: 'Articles' },
  { href: '/topics/', label: 'Topics' },
  { href: '/#paths', label: 'Learning paths' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img class="brand-logo" src="/images/logo.jpg" width="36" height="36" alt="" />
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a class="nav-cta" href="/#newsletter">Subscribe</a>
    </nav>
    <div class="palette">
      <button class="icon-btn" id="palette-toggle" type="button" aria-label="Choose colour palette" aria-expanded="false" aria-controls="palette-menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.9 1.8-1.9 0-.5-.2-.9-.5-1.3-.3-.3-.5-.8-.5-1.3 0-1 .8-1.8 1.8-1.8H17a4 4 0 0 0 4-4C21 6.5 17 3 12 3z"/><circle cx="7.5" cy="11" r="1.2"/><circle cx="10.5" cy="7" r="1.2"/><circle cx="15" cy="7.5" r="1.2"/></svg>
      </button>
      <div class="palette-menu" id="palette-menu" role="group" aria-label="Colour palette" hidden>
        <p class="palette-title">Colour palette</p>
        {PALETTES.map((p) => (
          <button type="button" class="palette-option" data-palette={p.id} aria-pressed="false">
            <span class="swatch" aria-hidden="true">
              {p.swatch.map((c) => <i style={`background:${c}`}></i>)}
            </span>
            {p.name}
            <svg class="check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
          </button>
        ))}
      </div>
    </div>
    <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch theme">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"/></svg>
    </button>
    <button class="icon-btn menu-btn" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <nav class="mobile-nav wrap" id="mobile-nav" aria-label="Mobile" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="/#newsletter">Subscribe</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header > .wrap { display: flex; align-items: center; gap: 12px; min-height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-family: var(--font-display); font-size: 1.6rem; font-weight: 400; letter-spacing: 0.03em; margin-right: auto; }
  .brand:hover { color: var(--ink); }
  .brand-logo { flex: none; width: 36px; height: 36px; border-radius: 8px; object-fit: cover; box-shadow: 0 0 0 1px var(--line), 0 0 14px var(--glow); }
  .nav { display: flex; gap: 4px; align-items: center; }
  .nav a { color: var(--muted); text-decoration: none; font-size: var(--step--1); font-weight: 500; padding: 10px 12px; border-radius: var(--radius); }
  .nav a:hover, .nav a[aria-current="page"] { color: var(--ink); background: var(--raise); }
  .nav .nav-cta { color: var(--accent-strong); }
  .icon-btn {
    display: inline-grid; place-items: center; width: 44px; height: 44px; flex: none;
    background: transparent; color: var(--muted); border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  .icon-btn:hover { color: var(--ink); border-color: var(--muted); }
  .menu-btn { display: none; }
  .palette { position: relative; }
  .palette-menu {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 6; width: 240px; max-width: calc(100vw - 32px);
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 8px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18); display: grid; gap: 2px;
  }
  .palette-title { font-size: 0.8125rem; color: var(--muted); padding: 4px 10px 6px; }
  .palette-option {
    display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 6px 10px; width: 100%;
    background: transparent; border: 0; border-radius: var(--radius); color: var(--ink); cursor: pointer;
    font: 500 var(--step--1) var(--font-ui); text-align: left;
  }
  .palette-option:hover { background: var(--raise); }
  .swatch { display: inline-flex; flex: none; border-radius: 999px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); }
  .swatch i { display: block; width: 12px; height: 24px; }
  .check { margin-left: auto; color: var(--accent-strong); visibility: hidden; }
  .palette-option[aria-pressed="true"] .check { visibility: visible; }
  .mobile-nav { display: grid; gap: 2px; padding-block: 8px 16px; }
  .mobile-nav a { color: var(--ink); text-decoration: none; padding: 12px 4px; border-bottom: 1px solid var(--line); }
  @media (max-width: 820px) {
    .nav { display: none; }
    .menu-btn { display: inline-grid; }
  }
  @media (min-width: 821px) { .mobile-nav { display: none !important; } }
</style>

<script>
  const root = document.documentElement;
  const mql = matchMedia('(prefers-color-scheme: light)');
  const themeBtn = document.getElementById('theme-toggle')!;
  const isLight = () => (root.dataset.theme ? root.dataset.theme === 'light' : mql.matches);
  const sync = () => themeBtn.setAttribute('aria-label', isLight() ? 'Switch to dark theme' : 'Switch to light theme');
  themeBtn.addEventListener('click', () => {
    root.dataset.theme = isLight() ? 'dark' : 'light';
    try { localStorage.setItem('aiera-theme', root.dataset.theme); } catch (_) {}
    sync();
  });
  mql.addEventListener('change', sync);
  sync();

  const paletteBtn = document.getElementById('palette-toggle')!;
  const paletteMenu = document.getElementById('palette-menu')!;
  const options = [...paletteMenu.querySelectorAll<HTMLButtonElement>('.palette-option')];
  const syncPalette = () => options.forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.palette === root.dataset.palette)));
  const setPaletteOpen = (open: boolean) => {
    paletteMenu.hidden = !open;
    paletteBtn.setAttribute('aria-expanded', String(open));
    if (open) (options.find((o) => o.getAttribute('aria-pressed') === 'true') ?? options[0]).focus();
  };
  paletteBtn.addEventListener('click', () => setPaletteOpen(paletteMenu.hidden));
  options.forEach((o) => o.addEventListener('click', () => {
    root.dataset.palette = o.dataset.palette;
    try { localStorage.setItem('aiera-palette', o.dataset.palette!); } catch (_) {}
    syncPalette();
  }));
  document.addEventListener('click', (e) => {
    if (!paletteMenu.hidden && !(e.target as Element).closest('.palette')) setPaletteOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !paletteMenu.hidden) { setPaletteOpen(false); paletteBtn.focus(); }
  });
  syncPalette();

  const menuBtn = document.getElementById('menu-toggle')!;
  const mobileNav = document.getElementById('mobile-nav')!;
  menuBtn.addEventListener('click', () => {
    const open = mobileNav.hidden;
    mobileNav.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
