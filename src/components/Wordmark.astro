---
// AIERA-TS wordmark: lowercase "aiera" with a glowing dot on the i, plus a "ts" badge.
interface Props { size?: 'md' | 'lg' }
const { size = 'md' } = Astro.props;
---
<span class={`wordmark ${size}`} aria-label="AIERA-TS" role="img">
  <span class="word" aria-hidden="true">a<span class="i">ı<span class="dot"></span></span>era</span>
  <span class="badge" aria-hidden="true">ts</span>
</span>

<style>
  .wordmark { display: inline-flex; align-items: center; gap: 0.28em; font-family: var(--font-ui); font-weight: 600; letter-spacing: -0.035em; line-height: 1; color: var(--ink); }
  .md { font-size: 1.55rem; }
  .lg { font-size: 1.8rem; }
  .i { position: relative; display: inline-block; }
  .dot { position: absolute; left: 50%; top: -0.06em; width: 0.24em; height: 0.24em; border-radius: 50%; transform: translateX(-50%);
    background: var(--accent); box-shadow: 0 0 0 0.09em color-mix(in srgb, var(--accent) 22%, transparent); }
  .badge { font-size: 0.6em; letter-spacing: 0; padding: 0.28em 0.6em 0.32em; border-radius: 999px; background: var(--spark); color: #FFFFFF; }
  :root[data-theme="dark"] .badge { color: #061522; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .badge { color: #061522; } }
</style>
