---
// AIERA-TS wordmark: glossy green "aiera" with a gold bead on the i, plus a glossy "ts" badge.
interface Props { size?: 'md' | 'lg' }
const { size = 'md' } = Astro.props;
---
<span class={`wordmark ${size}`} aria-label="AIERA-TS" role="img">
  <span class="word" aria-hidden="true">a<span class="i">ı<span class="dot"></span></span>era</span>
  <span class="badge" aria-hidden="true"><span class="ts">ts</span></span>
</span>

<style>
  .wordmark {
    --wm-top: #2F9A62; --wm-mid: #17603C; --wm-low: #0F4A2C; --wm-shine: rgba(255, 255, 255, 0.55);
    --badge-top: #36A86B; --badge-low: #11502F; --badge-ink: #FFFFFF;
    display: inline-flex; align-items: center; gap: 0.26em;
    font-family: var(--font-ui); font-weight: 700; letter-spacing: -0.04em; line-height: 1;
  }
  .md { font-size: clamp(1.65rem, 5.2vw, 1.95rem); }
  .lg { font-size: 2.3rem; }

  /* Glossy gradient letters with a soft sheen across the top half */
  .word {
    background:
      linear-gradient(180deg, var(--wm-shine) 0%, rgba(255, 255, 255, 0) 46%),
      linear-gradient(180deg, var(--wm-top) 0%, var(--wm-mid) 55%, var(--wm-low) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.35)) drop-shadow(0 3px 6px rgba(15, 74, 44, 0.22));
    padding-block: 0.08em;
  }

  /* Gold bead on the i */
  .i { position: relative; display: inline-block; }
  .dot {
    position: absolute; left: 50%; top: -0.02em; width: 0.27em; height: 0.27em; border-radius: 50%; transform: translateX(-50%);
    background: radial-gradient(circle at 34% 30%, #FFF6C8 0 18%, #F5CC4E 42%, #C98F14 100%);
    box-shadow: 0 0 0 0.07em rgba(245, 204, 78, 0.28), 0 0.06em 0.18em rgba(201, 143, 20, 0.55);
  }

  /* Glossy pill badge */
  .badge {
    position: relative; overflow: hidden;
    font-size: 0.58em; font-weight: 700; letter-spacing: 0.01em; padding: 0.3em 0.66em 0.34em; border-radius: 999px;
    color: var(--badge-ink);
    background: linear-gradient(180deg, var(--badge-top), var(--badge-low));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45), inset 0 -1px 0 rgba(0, 0, 0, 0.18), 0 3px 8px rgba(15, 74, 44, 0.28);
  }
  /* Shiny gold letters inside the badge */
  .ts {
    position: relative; z-index: 1;
    background: linear-gradient(180deg, #FFF4C2 0%, #F5CC4E 40%, #C98F14 68%, #F0C75A 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 1px 0 rgba(10, 51, 32, 0.55));
  }
  .badge::before {
    content: ""; position: absolute; left: 8%; right: 8%; top: 6%; height: 45%; border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0)); pointer-events: none;
  }

  /* Dark mode: lighter, luminous greens */
  :root[data-theme="dark"] .wordmark {
    --wm-top: #C9F0D6; --wm-mid: #8FD1A8; --wm-low: #5DAE7F; --wm-shine: rgba(255, 255, 255, 0.35);
    --badge-top: #2F9A62; --badge-low: #0F4A2C; --badge-ink: #FFFFFF;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .wordmark {
      --wm-top: #C9F0D6; --wm-mid: #8FD1A8; --wm-low: #5DAE7F; --wm-shine: rgba(255, 255, 255, 0.35);
      --badge-top: #2F9A62; --badge-low: #0F4A2C; --badge-ink: #FFFFFF;
    }
  }
</style>
