---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { TOPICS } from '../../data/site';
import { getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return TOPICS.map((t) => ({
    params: { topic: t.slug },
    props: { topic: t, posts: posts.filter((p) => p.data.topic === t.name) },
  }));
}

interface Props { topic: (typeof TOPICS)[number]; posts: Post[] }
const { topic, posts } = Astro.props;
---
<BaseLayout title={topic.name} description={`AIERA articles on ${topic.name}: ${topic.blurb}`}>
  <section class="page">
    <div class="wrap">
      <a class="back" href="/topics/">All topics</a>
      <h1>{topic.name}</h1>
      <p class="lede">{topic.blurb}</p>
      <div class="list">
        {posts.length
          ? <PostList posts={posts} />
          : <p class="empty">No articles on this topic yet. <a href="/#newsletter">Subscribe</a> to hear when the first one is out.</p>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .back { display: inline-flex; min-height: 44px; align-items: center; font-size: var(--step--1); font-weight: 500; text-decoration: none; }
  .lede { max-width: 52ch; }
  .list { margin-top: 40px; }
  .empty { color: var(--muted); padding-block: 24px; border-top: 1px solid var(--line); }
</style>
