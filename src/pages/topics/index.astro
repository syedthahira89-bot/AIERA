---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS, PILLARS } from '../../data/site';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---
<BaseLayout title="Topics" description="Browse AIERA by topic: AI for a better life, and how AI works, explained simply.">
  <section class="page">
    <div class="wrap">
      <h1>Topics</h1>
      <p class="lede">AIERA has two sides: how AI is making life better, and how it actually works. Pick a topic to see every article on it.</p>
      {PILLARS.map((pillar) => (
        <section class="pillar" aria-labelledby={`pillar-${pillar.id}`}>
          <h2 id={`pillar-${pillar.id}`}>{pillar.name}</h2>
          <p class="pillar-blurb">{pillar.blurb}</p>
          <ul class="topic-grid">
            {TOPICS.filter((t) => t.pillar === pillar.id).map((t) => {
              const n = posts.filter((p) => p.data.topic === t.name).length;
              return (
                <li>
                  <a href={`/topics/${t.slug}/`}>
                    <h3>{t.name}</h3>
                    <p>{t.blurb}</p>
                    <span>{n ? `${n} article${n === 1 ? '' : 's'}` : 'First article coming soon'}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .lede { max-width: 56ch; }
  .pillar { margin-top: 48px; }
  .pillar h2 { font-size: var(--step-3); }
  .pillar-blurb { color: var(--muted); margin-top: 6px; max-width: 60ch; }
  .topic-grid { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; }
  @media (max-width: 640px) { .topic-grid { grid-template-columns: minmax(0, 1fr); } }
  a { display: grid; gap: 8px; padding-block: 24px; border-top: 1px solid var(--line); color: inherit; text-decoration: none; height: 100%; align-content: start; }
  a:hover h3 { color: var(--accent-strong); }
  h3 { font-size: var(--step-2); transition: color .15s; }
  p { color: var(--muted); }
  span { font-size: var(--step--1); color: var(--accent-strong); font-weight: 500; }
</style>
