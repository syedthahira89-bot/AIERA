---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS } from '../../data/site';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---
<BaseLayout title="Topics" description="Browse AIERA articles by topic, from language models to MLOps.">
  <section class="page">
    <div class="wrap">
      <h1>Topics</h1>
      <p class="lede">Pick an area to see every article on it, from the basics to the research edge.</p>
      <ul class="topic-grid">
        {TOPICS.map((t) => {
          const n = posts.filter((p) => p.data.topic === t.name).length;
          return (
            <li>
              <a href={`/topics/${t.slug}/`}>
                <h2>{t.name}</h2>
                <p>{t.blurb}</p>
                <span>{n} article{n === 1 ? '' : 's'}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lede { max-width: 52ch; }
  .topic-grid { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 40px; }
  @media (max-width: 900px) { .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .topic-grid { grid-template-columns: minmax(0, 1fr); } }
  a { display: grid; gap: 8px; padding-block: 24px; border-top: 1px solid var(--line); color: inherit; text-decoration: none; height: 100%; align-content: start; }
  a:hover h2 { color: var(--accent-strong); }
  h2 { font-size: var(--step-2); transition: color .15s; }
  p { color: var(--muted); }
  span { font-size: var(--step--1); color: var(--accent-strong); font-weight: 500; }
</style>
