---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GLOSSARY, termId } from '../data/glossary';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const titles = new Map(posts.map((p) => [p.id, p.data.title]));
const terms = [...GLOSSARY].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const groups = new Map<string, typeof terms>();
for (const t of terms) {
  const letter = t.term[0].toUpperCase();
  groups.set(letter, [...(groups.get(letter) ?? []), t]);
}
const letters = [...groups.keys()];
---
<BaseLayout title="AI glossary" description="Friendly, plain-language explanations of AI words, from attention to weight decay, each linked to an article that explores it further.">
  <section class="page">
    <div class="wrap glossary">
      <header class="intro">
        <h1>AI glossary</h1>
        <p class="lede">Curious about a word you've seen in an article? Here are {terms.length} AI terms explained in plain language, each with a link to learn more.</p>
      </header>

      <div class="tools">
        <div class="search">
          <label class="visually-hidden" for="glossary-search">Search the glossary</label>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input id="glossary-search" type="search" placeholder="Search a word, like token or drift" autocomplete="off" />
        </div>
        <nav class="letters" aria-label="Jump to letter">
          {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
        </nav>
      </div>

      <p class="visually-hidden" id="glossary-status" aria-live="polite"></p>

      {letters.map((l) => (
        <section class="group" id={`letter-${l}`} aria-labelledby={`letter-${l}-title`}>
          <h2 id={`letter-${l}-title`}>{l}</h2>
          <dl>
            {groups.get(l)!.map((t) => (
              <div class="entry" id={termId(t.term)} data-search={`${t.term} ${t.definition}`.toLowerCase()}>
                <dt>{t.term}</dt>
                <dd>
                  <p>{t.definition}</p>
                  {(t.article && titles.has(t.article)) || t.seeAlso ? (
                    <p class="more">
                      {t.article && titles.has(t.article) && <a href={`/blog/${t.article}/`}>Read: {titles.get(t.article)}</a>}
                      {t.seeAlso && (
                        <span class="see">See also: {t.seeAlso.map((s, i) => <>{i > 0 && ', '}<a href={`#${termId(s)}`}>{s}</a></>)}</span>
                      )}
                    </p>
                  ) : null}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}

      <div class="empty" id="glossary-empty" hidden>
        <p>No terms match your search yet. Try a shorter word, or <a href="/contact/">suggest a term</a> you'd like explained.</p>
      </div>

      <p class="suggest">Missing a word? <a href="/contact/">Suggest a term</a> and we'll add a friendly explanation.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .glossary { max-width: 860px; }
  .lede { max-width: 56ch; }
  .tools { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 64px); z-index: 2; background: var(--bg); padding-block: 16px; margin-top: 24px; border-bottom: 1px solid var(--line); display: grid; gap: 12px; }
  .search { position: relative; max-width: 420px; }
  .search input {
    width: 100%; min-height: 44px; padding: 0 14px 0 40px; font: 400 var(--step-0) var(--font-ui);
    color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .search input::placeholder { color: var(--muted); }
  .search svg { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  .letters { display: flex; flex-wrap: wrap; gap: 4px; }
  .letters a { display: inline-grid; place-items: center; min-width: 36px; min-height: 36px; border-radius: var(--radius); text-decoration: none; font-weight: 600; font-size: var(--step--1); color: var(--accent-strong); }
  .letters a:hover { background: var(--raise); }
  .group { padding-top: 28px; scroll-margin-top: 180px; }
  .group h2 { font-size: var(--step-3); color: var(--accent-strong); margin-bottom: 4px; }
  dl { margin: 0; }
  .entry { padding-block: 18px; border-bottom: 1px solid var(--line); scroll-margin-top: 180px; }
  .entry:target { background: var(--raise); border-radius: var(--radius); padding-inline: 12px; }
  dt { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.2; }
  dd { margin: 6px 0 0; }
  dd p { max-width: 66ch; }
  .more { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: var(--step--1); }
  .see { color: var(--muted); }
  .empty { padding-block: 32px; color: var(--muted); }
  .suggest { margin-top: 40px; color: var(--muted); }
</style>

<script>
  const input = document.getElementById('glossary-search') as HTMLInputElement;
  const entries = [...document.querySelectorAll<HTMLElement>('.entry')];
  const groups = [...document.querySelectorAll<HTMLElement>('.group')];
  const empty = document.getElementById('glossary-empty')!;
  const status = document.getElementById('glossary-status')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const e of entries) {
      const match = !q || e.dataset.search!.includes(q);
      e.hidden = !match;
      if (match) shown++;
    }
    for (const g of groups) g.hidden = ![...g.querySelectorAll<HTMLElement>('.entry')].some((e) => !e.hidden);
    empty.hidden = shown > 0;
    status.textContent = `${shown} term${shown === 1 ? '' : 's'} shown`;
  });
</script>
