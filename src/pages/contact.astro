---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---
<BaseLayout title="Contact" description="How to reach the AIERA team with corrections, topic ideas or partnership questions.">
  <section class="page">
    <div class="wrap page-inner">
      <h1>Contact</h1>
      <p class="lede">We read every message. Corrections get the fastest reply.</p>

      <div class="email">
        <span>Email us at</span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>

      <div class="reasons">
        <div>
          <h2>Corrections</h2>
          <p>Spotted an error in an article or a code sample? Include the article link and what needs fixing.</p>
        </div>
        <div>
          <h2>Topic ideas</h2>
          <p>Tell us which idea in machine learning you would like explained next.</p>
        </div>
        <div>
          <h2>Guest posts and partnerships</h2>
          <p>We publish a small number of guest articles. Send a short outline and a link to something you have written.</p>
        </div>
      </div>

      <p class="social">You can also find us on {SITE.social.map((s, i) => <>{i > 0 && (i === SITE.social.length - 1 ? ' and ' : ', ')}<a href={s.href} target="_blank" rel="noopener">{s.label}</a></>)}.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .email { margin-top: 32px; padding: 20px 24px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; display: grid; gap: 4px; }
  .email span { font-size: var(--step--1); color: var(--muted); }
  .email a { font-family: var(--font-display); font-size: var(--step-2); text-decoration: none; overflow-wrap: anywhere; }
  .reasons { margin-top: 40px; display: grid; gap: 28px; }
  h2 { font-size: var(--step-1); }
  .reasons p { color: var(--muted); margin-top: 6px; max-width: 60ch; }
  .social { margin-top: 40px; color: var(--muted); }
</style>
